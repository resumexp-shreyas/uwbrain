# Copy to .env and fill in real values. .env is git-ignored.

# Gemini Developer API key -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Only needed if DATABASES is switched back to PostgreSQL (sqlite is the default)
DB_PASSWORD=""

# Google Cloud Document AI (medical records upload). Create a processor of type
# "Enterprise Document OCR" and enable billing + the Document AI API on the project.
# Auth uses Application Default Credentials: set GOOGLE_APPLICATION_CREDENTIALS to a
# service-account JSON (role: Document AI API User) or run `gcloud auth application-default login`.
DOCAI_PROJECT_ID=""
DOCAI_LOCATION="us"          # Document AI supports "us" and "eu"
DOCAI_PROCESSOR_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# LLM backend: "vertex" (Gemini on Vertex AI, uses Application Default Credentials) or "api" (GEMINI_API_KEY)
LLM_BACKEND="vertex"
GOOGLE_CLOUD_PROJECT=""
VERTEX_LOCATION="global"          # or a region such as us-central1 / asia-south1 if the model is offered there
# Optional model overrides (run `python check_llm.py` to see what your project can use)
# LLM_MODEL_FAST="gemini-3.5-flash-lite"
# LLM_MODEL_DECISION="gemini-3.5-flash"

# Optional: USD per 1M tokens as "input,output" (see the Gemini / Vertex AI pricing page) to show cost estimates
# LLM_PRICE_FAST="0.10,0.40"
# LLM_PRICE_DECISION="0.30,2.50"
# DOCAI_PRICE_PER_1000_PAGES="1.50"
